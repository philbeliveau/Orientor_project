2025-07-16 20:43:41,575 - app.api.endpoints.job_recommendations - INFO - Arbre de compétences généré: {'nodes': {'occupation::key_15226': {'id': 'occupation::key_15226', 'type': 'occupation', 'label': 'foundry manager', 'metadata': {'label': 'foundry manager', 'type': 'occupation', 'originuri': 'http://data.europa.eu/esco/occupation/0552ff45-b282-455c-b431-fb05a0e00801', 'uuidhistory': 'f8e52b4e-7362-4d72-a03f-5d51df1fd412\n87c7d7a7-cb99-4d8a-8018-5d5e86efad18', 'occupationgroupcode': '1219', 'code': '1219.5.2', 'preferredlabel': 'foundry manager', 'altlabels': 'process manager\nfoundry production manager\nengineering manager\nproduction controller\nfoundry manager\nfoundry plant manager\nfoundry operations manager', 'description': 'Foundry managers\xa0coordinate and implement short and medium term casting production schedules, and coordinate the development, support and improvement of casting processes, and the reliability efforts of the maintenance and engineering departments. They also partner with ongoing remediation initiatives.', 'definition': '', 'scopenote': '', 'regulatedprofessionnote': 'http://data.europa.eu/esco/regulated-professions/unregulated', 'occupationtype': 'escooccupation', 'islocalized': 'false'}, 'is_anchor': True, 'depth': 0}, 'skill::key_13911': {'id': 'skill::key_13911', 'type': 'skill', 'label': 'follow manufacturing work schedule', 'metadata': {'label': 'follow manufacturing work schedule', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/ea0e069a-d1c1-4c11-b4aa-af9809815d3e', 'uuidhistory': '286c7cb1-96fc-42a7-b67d-4bf11a744d04\n9eb6ba59-81fb-46de-90bd-1f47d0c0b09e', 'skilltype': 'skill/competence', 'reuselevel': 'sector-specific', 'preferredlabel': 'follow manufacturing work schedule', 'altlabels': 'comply with manufacturing work schedule\ncomplying with manufacturing work schedule\nfollowing manufacturing work schedule\nmanufacturing work schedule following\nfollow manufacturing work schedule\ncompliance with manufacturing work schedule\nmanufacturing work schedule compliance\nfollowing of manufacturing work schedule', 'description': "Follow the planning set up by manufacturing companies' managers exactly to ensure one production process is not delayed due to another and they follow each other smoothly.", 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_4116': {'id': 'skill::key_4116', 'type': 'skill', 'label': 'manage staff', 'metadata': {'label': 'manage staff', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/339ac029-066a-4985-9f9d-b3d7c8fea0bb', 'uuidhistory': '15286fcd-79f7-42f7-b2fc-42e963cfd729\ncc4c7941-2c81-40ec-b72b-3a0b857ae008', 'skilltype': 'skill/competence', 'reuselevel': 'cross-sector', 'preferredlabel': 'manage staff', 'altlabels': 'coordinate and monitor employees\nmanage subordinates\ncoordinate and monitor subordinates\nmanage team\nmanage staff\ncoordinate and monitor staff\nmanage employees', 'description': 'Manage employees and subordinates, working in a team or individually, to maximise their performance and contribution. Schedule their work and activities, give instructions, motivate and direct the workers to meet the company objectives. Monitor and measure how an employee undertakes their responsibilities and how well these activities are executed. Identify areas for improvement and make suggestions to achieve this. Lead a group of people to help them achieve goals and maintain an effective working relationship among staff.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_2609': {'id': 'skill::key_2609', 'type': 'skill', 'label': 'follow work schedule', 'metadata': {'label': 'follow work schedule', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/194c05ed-253c-485a-8bf0-0c8de1aaafda', 'uuidhistory': '448a0944-33d6-4c69-90db-70a7fbb4c65d\nba5b223f-7b7a-473d-bafa-7aad4ec74527', 'skilltype': 'skill/competence', 'reuselevel': 'cross-sector', 'preferredlabel': 'follow work schedule', 'altlabels': 'obey work schedule\nrespect work schedule\nfollow work schedule\nfollowing work schedule\nfollow work schedules\nimplement work schedule', 'description': 'Manage the sequence of activities in order to deliver completed work on agreed deadlines by following a work schedule.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 2}, 'occupation::key_17295': {'id': 'occupation::key_17295', 'type': 'occupation', 'label': 'industrial assembly supervisor', 'metadata': {'label': 'industrial assembly supervisor', 'type': 'occupation', 'originuri': 'http://data.europa.eu/esco/occupation/b12b14fd-5b74-40c6-afd9-dd35b34e27ed', 'uuidhistory': 'c6559624-cb91-47d6-b5e5-1b65489e28f3\nf0bd007c-9d1f-43f5-975e-18061ca34e96', 'occupationgroupcode': '3122', 'code': '3122.3', 'preferredlabel': 'industrial assembly supervisor', 'altlabels': 'quality control supervisor\nassembly team leader\nassembly foreman\ngoods compliance supervisor\nassembly overseer\nassembly chargehand\nassembly co-ordinator\nassembly forewoman\nassembly controller\nproduction assembly supervisor\nquality supervisor\nassembly line supervisor\nindustrial assembly supervisor\nassembly planner\ngoods production supervisor', 'description': 'Industrial assembly supervisors are in charge of organizing, planning and coordinating assembly operations. They keep track of all the work activities and manage the process for efficient functioning in order to tackle problems such as production loss. They answer to the industrial production and the manufacturing manager.', 'definition': '', 'scopenote': '', 'regulatedprofessionnote': 'http://data.europa.eu/esco/regulated-professions/unregulated', 'occupationtype': 'escooccupation', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 2}, 'skill::key_10732': {'id': 'skill::key_10732', 'type': 'skill', 'label': 'manage healthcare staff', 'metadata': {'label': 'manage