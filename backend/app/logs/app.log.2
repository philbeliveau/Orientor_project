2025-07-16 20:43:28,089 - app.api.endpoints.job_recommendations - INFO - Arbre de compétences généré: {'nodes': {'occupation::key_15156': {'id': 'occupation::key_15156', 'type': 'occupation', 'label': 'technical director', 'metadata': {'label': 'technical director', 'type': 'occupation', 'originuri': 'http://data.europa.eu/esco/occupation/00030d09-2b3a-4efd-87cc-c4ea39d27c34', 'uuidhistory': '74b23464-bee1-4bce-aad6-1c6448ef73b7\n583cf200-fe20-4ec5-b5c9-d1a4c4fa4adb', 'occupationgroupcode': '2654', 'code': '2654.1.7', 'preferredlabel': 'technical director', 'altlabels': 'technical and operations director\nhead of technical\ndirector of technical arts\nhead of technical department\ntechnical supervisor\ntechnical director\ntechnical manager', 'description': 'Technical directors realise the artistic visions of the creators within technical constraints. They coordinate the operations of various production units, such as scene, wardrobe, sound and lighting, and make-up. They adapt the prototype and study the feasibility, implementation, operation and technical monitoring of the artistic project. They are also responsible for the stage equipment and technical equipment.', 'definition': '', 'scopenote': '', 'regulatedprofessionnote': 'http://data.europa.eu/esco/regulated-professions/unregulated', 'occupationtype': 'escooccupation', 'islocalized': 'false'}, 'is_anchor': True, 'depth': 0}, 'skill::key_14612': {'id': 'skill::key_14612', 'type': 'skill', 'label': 'coordinate technical teams in artistic productions', 'metadata': {'label': 'coordinate technical teams in artistic productions', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/f64fe2c2-d090-4e91-ba74-1355d96b9bca', 'uuidhistory': 'a968d39f-3115-4faf-99f7-cb0928617813\naa616ee4-505c-417b-9fb7-c4365447b36d', 'skilltype': 'skill/competence', 'reuselevel': 'sector-specific', 'preferredlabel': 'coordinate technical teams in artistic productions', 'altlabels': 'supervise technical teams during a production\ncoordinate technical teams in artistic productions\ncoordinate technical teams during artistic production\ncoordinate technical teams\ncoordinate technical teams for artistic production', 'description': 'Plan, coordinate and supervise the work of the technical teams such as scene, wardrobe, light and sound, make-up and hairdressing and props during set-up, rehearsals, performances and dismantling.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_5177': {'id': 'skill::key_5177', 'type': 'skill', 'label': 'coordinate with creative departments', 'metadata': {'label': 'coordinate with creative departments', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/47ed1d37-971b-472c-86be-26f893991274', 'uuidhistory': '75ae742d-025c-445f-b86b-78b2a747e2f2\n665cd979-0139-47ab-a351-e3b3246102a3', 'skilltype': 'skill/competence', 'reuselevel': 'sector-specific', 'preferredlabel': 'coordinate with creative departments', 'altlabels': 'liaise with other artistic departments\ncoordinate with creative departments\ncoordinate with creation departments\ncoordinate with departments of creativity\nconsult with other creative units', 'description': 'Coordinate activities with other artistic and creative departments.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_10157': {'id': 'skill::key_10157', 'type': 'skill', 'label': 'help write technical riders', 'metadata': {'label': 'help write technical riders', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/a2dfc063-7b24-4258-a778-d395c41d4966', 'uuidhistory': '7066bd82-d97c-4777-a455-531d9ea746ee\n99728627-6ab0-4808-8806-020cdafabdaa', 'skilltype': 'skill/competence', 'reuselevel': 'sector-specific', 'preferredlabel': 'help write technical riders', 'altlabels': 'help write technical riders\nhelp prepare technical riders\ncollaborate for the creation of technical riders\nhelp draw up technical riders\ncontribute to the creation of technical riders\nparticipate in the creation of technical riders\nparticipate in the writing of technical riders', 'description': 'Participate in all aspects of the creation of technical riders. Create, or help create, cues for the technical crew in coordination with creators, directors and designers team. Verify that the crew understand the cues. Write a list of technical specifications. Indicate the performance schedule and specify needs related to staging the production.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 2}, 'skillgroup::key_1113': {'id': 'skillgroup::key_1113', 'type': 'skillgroup', 'label': 'supervising a team or group', 'metadata': {'label': 'supervising a team or group', 'type': 'skillgroup', 'originuri': 'http://data.europa.eu/esco/skill/aab9f44d-fe0e-46d8-a470-11ce82a64846', 'uuidhistory': '908f14f9-a815-4816-944a-9a79e24b4a13\na444ef41-9209-436a-be11-5d96f2604a2f', 'code': 'S4.8.1', 'preferredlabel': 'supervising a team or group', 'altlabels': 'supervising a team or group', 'description': 'Managing, leading or supervising the activities a team or group of workers or students.', 'scopenote': 'Examples:\n- lead a team\n- manage sales teams\n- supervise crew\n\nExcludes:\n- supervise children'}, 'is_anchor': False, 'depth': 2}, 'occupation::key_17619': {'id': 'occupation::key_17619', 'type': 'occupation', 'label': 'art director', 'metadata': {'label': 'art director', 'type': 'occupation', 'originuri': 'http://data.europa.eu/esco/occupation/cb93fd23-1f51-4495-867a-936c1967066b', 'uuidhistory': '00cccd57-ae1a-470c-86b8-84f14c99b4a9\n9308daac-31c9-45fa-933c-8eedec5f4213', 'occupationgroupcode': '2654', 'code': '2654.1', 'preferredlabel': 'art director', 'altlabels': 'advertising art director\ncreative director\nvisual art director\ndesigner\nartistic projects manager\nart director\nmaestro\nstage director', 'description': 'Art directors shape the visual layout of a concept. They create innovative designs, develop artistic projects \xa0and manage the cooperation between all aspects involved. Art directors may perform creative work in theatre, marketing, advertising, video and motion picture, fashion or online companies. They ensure that the work performed is visually appealing to audiences.', 'definition': '', 'scopenote': '', 'regulatedprofessionnote': 'http://data.europa.eu/esco/regulated-professions/unregulated', 'occupationtype': 'escooccupation', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 2}, 'skill::key_9411': {'id': 'skill::key_9411', 'type': 'skill', 'label': 'define creative components', 'metadata': {'label': 'define creative components', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/94a56423-06a2-4753-b158-4d9231c8293e', 'uuidhistory': 'c9697fb4-0da0-41df-9cf9-1317f39c32f3\nf6476bb2-6505-497a-a0fe-02f0713c56aa', 'skilltype': 'skill/competence', 'reuselevel': 'sector-specific', 'preferredlabel': 'define creative components', 'altlabels': 'specify creative components\noutline creative components\ndefine creative components\ndefining creative components\ndetermine creative components', 'description': 'Identify sources of inspiration and strong points. Identify the subject of the art production. Identify the content. Identify creative factors such as performers and music.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 2}, 'occupation::key_16344': {'id': 'occupation::key_16344', 'type': 'occupation', 'label': 'cultural facilities manager', 'metadata': {'label': 'cultural facilities manager', 'type': 'occupation', 'originuri': 'http://data.europa.eu/esco/occupation/6066ed14-ace3-4352-b656-2b621fd7bc88', 'uuidhistory': 'db379fec-79c8-466f-858f-0858b6815c7f\n7c52313c-84d9-4ad0-bd9b-53e6f7022124', 'occupationgroupcode': '1431', 'code': '1431.1', 'preferredlabel': 'cultural facilities manager', 'altlabels': 'cultural facilities program coordinator\ncultural facilities executive\ncultural facilities director\ncultural services manager\ncultural facilities manager', 'description': 'Cultural facilities managers direct the operations of facilities that provide cultural services such as theatre, museums and concert halls. They plan and organise the daily operations of the related staff and facilities and ensure the organisation follows the latest developments in its field. They coordinate the different departments of the facility and manage the correct use of resources, policies and budgets.', 'definition': '', 'scopenote': '', 'regulatedprofessionnote': 'http://data.europa.eu/esco/regulated-professions/unregulated', 'occupationtype': 'escooccupation', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 2}}, 'edges': [{'source': 'occupation::key_15156', 'target': 'skill::key_14612', 'weight': 0.8744372129440308, 'type': 'similarity'}, {'source': 'occupation::key_15156', 'target': 'skill::key_5177', 'weight': 0.7332482039928436, 'type': 'similarity'}, {'source': 'skill::key_14612', 'target': 'skill::key_10157', 'weight': 0.7683602571487427, 'type': 'similarity'}, {'source': 'skill::key_14612', 'target': 'skillgroup::key_1113', 'weight': 0.7136784046888351, 'type': 'similarity'}, {'source': 'skill::key_14612', 'target': 'occupation::key_17619', 'weight': 0.7007326632738113, 'type': 'similarity'}, {'source': 'skill::key_5177', 'target': 'skill::key_9411', 'weight': 0.7646620869636536, 'type': 'similarity'}, {'source': 'skill::key_5177', 'target': 'occupation::key_16344', 'weight': 0.7117408215999603, 'type': 'similarity'}], 'visualizations': {'plotly': {'figure': Figure({
