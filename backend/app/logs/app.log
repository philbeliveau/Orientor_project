s\nadminister accounts', 'description': 'Manage the accounts and financial activities of an organisation, supervising that all the documents are correctly maintained, that all the information and calculations are correct, and that proper decisions are being made.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_14557': {'id': 'skill::key_14557', 'type': 'skill', 'label': 'supervise accounting operations', 'metadata': {'label': 'supervise accounting operations', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/f5652e8e-7e25-4f3a-bd31-509c8406213f', 'uuidhistory': '3487db99-d25c-4fe3-956b-6dc157787bd2\n2092e9b6-3eec-4f78-8172-6a112d0b6019', 'skilltype': 'skill/competence', 'reuselevel': 'cross-sector', 'preferredlabel': 'supervise accounting operations', 'altlabels': 'supervising accounting operations\nmanage accounting operations accounting operations\noversee accounting operations\nsupervise account operations\nsupervise accounting operation\nsupervise accounting operations', 'description': 'Coordinate, commission, and monitor operations in accounting departments in order to ensure the accurate record and eventual reporting of the financial operations of the company.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_1671': {'id': 'skill::key_1671', 'type': 'skill', 'label': 'accounting department processes', 'metadata': {'label': 'accounting department processes', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/08371fe9-c658-4f6a-966f-71dbb0ab683d', 'uuidhistory': '918d75a6-92b1-4d23-b0bf-87999db63a90\n2fcb7822-2f81-4233-a2f8-c33bea3ca7ca', 'skilltype': 'knowledge', 'reuselevel': 'sector-specific', 'preferredlabel': 'accounting department processes', 'altlabels': 'accounting department processes\naccounting processes\naccounts department processes\naccounting department procedures, accounting department methods\naccounting department process', 'description': 'The different processes, duties, jargon, role in an organisation, and other specificities of the accounting department within an organisation such as bookkeeping, invoices, recording, and taxing.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_12916': {'id': 'skill::key_12916', 'type': 'skill', 'label': 'ensure compliance with accounting conventions', 'metadata': {'label': 'ensure compliance with accounting conventions', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/d6e78d9a-deca-4bcb-b08d-011b2616758d', 'uuidhistory': '76542646-8432-4ec5-bdc4-9d627ba23d1d\nc977903e-cd8e-40cc-b61c-f8c624109bfb', 'skilltype': 'skill/competence', 'reuselevel': 'cross-sector', 'preferredlabel': 'ensure compliance with accounting conventions', 'altlabels': 'certify compliance with accounting conventions\nensure compliance with accounting conventions\nensure compliance with accounting convention\nensure accounting conventions compliance\nguarantee compliance with accounting conventions\nensuring compliance with accounting conventions', 'description': 'Exercise accounting management and abidance by generally accepted accounting conventions such as recording transactions at the current price, quantifying goods, separating personal accounts of managers from those of the company, making effective the transfer of legal ownership of assets in its realisation time, and ensuring the principle of materiality.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}, 'skill::key_3617': {'id': 'skill::key_3617', 'type': 'skill', 'label': 'monitor financial accounts', 'metadata': {'label': 'monitor financial accounts', 'type': 'skill', 'originuri': 'http://data.europa.eu/esco/skill/2ada2f9d-77f7-4ba0-9096-89ae285a65c5', 'uuidhistory': 'f143b51f-13a9-4171-a3ea-4bbb464735bd\nc2628acc-ef7c-4be9-8df9-6e5998850a04', 'skilltype': 'skill/competence', 'reuselevel': 'cross-sector', 'preferredlabel': 'monitor financial accounts', 'altlabels': 'analyse financial accounts\nmonitor financial accounts\nanalyse financial records\nmonitor finance accounts', 'description': 'Handle financial administration of your department, keep the costs down to only necessary expenses and maximise the revenues of your organisation.', 'definition': '', 'scopenote': '', 'islocalized': 'false'}, 'is_anchor': False, 'depth': 1}}, 'edges': [{'source': 'occupation::key_15225', 'target': 'skill::key_13534', 'weight': 0.8510435223579407, 'type': 'similarity'}, {'source': 'occupation::key_15225', 'target': 'skill::key_14557', 'weight': 0.8297367691993713, 'type': 'similarity'}, {'source': 'occupation::key_15225', 'target': 'skill::key_1671', 'weight': 0.8026265799999237, 'type': 'similarity'}, {'source': 'occupation::key_15225', 'target': 'skill::key_12916', 'weight': 0.7958489954471588, 'type': 'similarity'}, {'source': 'occupation::key_15225', 'target': 'skill::key_3617', 'weight': 0.7870554029941559, 'type': 'similarity'}], 'visualizations': {'plotly': {'figure': Figure({
