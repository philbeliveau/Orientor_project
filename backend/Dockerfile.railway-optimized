# Railway-Optimized Dockerfile for Phase 1B
# Single-stage build optimized for Railway's environment

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Set environment variables for optimization
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8000 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies in one layer (cached unless OS changes)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    postgresql-client \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy requirements first (triggers rebuild only when requirements change)
COPY requirements.txt .

# Install Python dependencies in order of stability
# Core packages first (most stable)
RUN pip install --upgrade pip && \
    pip install fastapi==0.104.1 uvicorn==0.24.0 pydantic==2.5.0 pydantic-settings==2.1.0 && \
    pip install sqlalchemy==2.0.23 alembic==1.13.1 psycopg2-binary==2.9.10 && \
    pip install python-jose[cryptography]==3.3.0 python-multipart==0.0.6 bcrypt==4.1.2 && \
    pip install aiohttp==3.9.0 requests==2.31.0 httpx==0.24.1 && \
    pip install anthropic==0.31.2 openai==1.3.0 && \
    pip install python-dotenv==1.0.0

# Install data processing packages
RUN pip install "numpy<2.0.0,>=1.26.2" "pandas>=2.0.0"

# Install vector/search packages  
RUN pip install "pinecone>=3.0.0" redis==5.0.1

# Install ML packages (heaviest - last to minimize rebuild impact)
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.1.0 && \
    pip install torch-geometric==2.4.0 && \
    pip install scikit-learn==1.3.0 && \
    pip install sentence-transformers==2.2.2 && \
    pip install "matplotlib>=3.7.0" && \
    pip install "scipy>=1.11.0"

# Copy application code (rebuilds only when code changes)
COPY . .

# Create health check script
RUN echo '#!/bin/bash\ncurl -f http://localhost:$PORT/health || exit 1' > /healthcheck.sh && \
    chmod +x /healthcheck.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /healthcheck.sh

# Expose port
EXPOSE 8000

# Start command
CMD ["python", "-m", "uvicorn", "main_deploy:app", "--host", "0.0.0.0", "--port", "8000"]